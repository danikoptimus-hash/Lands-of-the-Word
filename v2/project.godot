; Настройки проекта Godot. «Земли Слова», версия 2 — клиент с объёмным миром.
; Движок: Godot 4.6.2 (версия закреплена, см. v2/README.md).

config_version=5

[application]

config/name="Земли Слова"
config/description="Версия 2: тот же мир и те же партии в объёме."
config/version="0.9.1"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.086, 0.078, 0.07, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.086, 0.078, 0.07, 1)

[shader_globals]

cloud_drift={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cloud_look={
"type": "vec4",
"value": Vector4(1, 0, 0.32, 0)
}
cloud_sun={
"type": "vec4",
"value": Vector4(-0.78, 0.58, 0.22, 0)
}
flash_at={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
rain_look={
"type": "vec4",
"value": Vector4(0, 0, 0.3, 0)
}
wind_look={
"type": "vec4",
"value": Vector4(0.867, 0.498, 0.25, 0)
}
cloud_eye={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
rain_wet={
"type": "float",
"value": 0.0
}
haze_look={
"type": "vec4",
"value": Vector4(4.5e-05, 0.000667, 0, 0.5)
}
haze_color={
"type": "vec4",
"value": Vector4(0.26, 0.57, 0.95, 1)
}
haze_glow_color={
"type": "vec4",
"value": Vector4(1, 0.79, 0.45, 1)
}
haze_sun={
"type": "vec4",
"value": Vector4(-0.78, 0.58, 0.22, 0)
}
haze_sun_color={
"type": "vec4",
"value": Vector4(1, 0.89, 0.71, 1)
}
