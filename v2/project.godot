; Настройки проекта Godot. «Земли Слова», версия 2 — клиент с объёмным миром.
; Движок: Godot 4.6.2 (версия закреплена, см. v2/README.md).

config_version=5

[application]

config/name="Земли Слова"
config/description="Версия 2: тот же мир и те же партии в объёме."
config/version="0.7.4"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.086, 0.078, 0.07, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.086, 0.078, 0.07, 1)
