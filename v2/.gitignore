# Служебные файлы движка: создаются заново при открытии проекта.
.godot/
*.translation
# Номера ресурсов и настройки импорта движок пишет сам при импорте (конвейер и v2/tools/godot-local.sh).
# Сцены ссылаются на скрипты по пути, а не по номеру, поэтому хранить их не нужно.
*.uid
*.import
# Исключение — материалы земли: им нужны свои настройки импорта (атлас слоёв 4×4, уменьшенные копии шума).
!/assets/terrain/*.import
# И карты погоды: карта облаков — с уменьшенными копиями, объёмный шум — как объёмная текстура (8×8 срезов);
# без этих настроек движок импортирует шум плоской картинкой, и программа не собирается (так упал конвейер на 0.8.1).
!/assets/weather/*.import
# Сборки не хранятся в репозитории: их делает конвейер (.github/workflows/v2.yml).
/build/
/out/
