generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum GameStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum NodeKind {
  EMPTY
  CITY
  START
}

model User {
  id           String       @id @default(cuid())
  nickname     String       @unique
  passwordHash String
  email        String?      @unique
  displayName  String?
  locale       String       @default("ru")
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  sessions     Session[]
  gameAdmins   GameAdmin[]
  createdGames Game[]       @relation("GameCreator")
  memberships  Membership[]
  resets       PasswordReset[]
}

enum ResetKind {
  EMAIL
  ADMIN
}

/** Одноразовая ссылка сброса пароля. id — SHA-256 от токена из ссылки; сам токен нигде не хранится. */
model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ResetKind @default(EMAIL)
  issuedBy  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  games     Game[]
}

model Game {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  status      GameStatus   @default(DRAFT)
  teamCount   Int
  settings    Json         @default("{}")
  mapSeed     Int?
  createdById String
  createdBy   User         @relation("GameCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  admins      GameAdmin[]
  hexes       MapHex[]
  nodes       MapNode[]
  edges       MapEdge[]
  teams       Team[]
  invites     Invite[]
  deeds       Deed[]
  startedAt   DateTime?
}

model GameAdmin {
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gameId, userId])
}

/** Гекс — местность (декорация и туман). */
model MapHex {
  id       String @id @default(cuid())
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  q        Int
  r        Int
  terrain  String
  rotation Int    @default(0)

  @@unique([gameId, q, r])
}

/** Узел — перекрёсток (вершина гекса): развилка, город или старт. */
model MapNode {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  key       String
  corner    String   @default("N")
  q         Int
  r         Int
  kind      NodeKind
  bookCode  String?
  cityType  String?
  teamIndex Int?
  /** Ключ конверта города (генерируется при старте игры, виден только админу). */
  cityKey   String?
  /** Уровень защиты города: сколько стихов надо, чтобы его взять (следующая атака ≥ level + 1). */
  defenseLevel  Int     @default(0)
  /** Книга исчерпана: ставки считаются суммой стихов по участникам. */
  sumMode       Boolean @default(false)
  /** Отражена атака в суммарном режиме: город закреплён навсегда. */
  lockedForever Boolean @default(false)

  @@unique([gameId, key])
}

model MapEdge {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  aKey   String
  bKey   String

  @@unique([gameId, aKey, bKey])
}

enum TeamRole {
  CAPTAIN
  MEMBER
}

enum GameRole {
  NONE
  SCOUT
  PROPHET
  AMBASSADOR
  CHRONICLER
}

model Team {
  id           String       @id @default(cuid())
  gameId       String
  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  index        Int
  name         String
  color        String
  startNodeKey String?
  status       String       @default("active")
  createdAt    DateTime     @default(now())
  members      Membership[]
  invites      Invite[]
  nodeStates   TeamNodeState[]
  edgeTasks    TeamEdgeTask[]
  cityStates   TeamCityState[]
  attacks      Battle[]  @relation("attacker")
  defenses     Battle[]  @relation("defender")

  @@unique([gameId, index])
  @@unique([gameId, name])
}

model Membership {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(MEMBER)
  gameRole GameRole @default(NONE)
  joinedAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

model Invite {
  id        String   @id
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole @default(MEMBER)
  usesLeft  Int      @default(20)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum ProofType {
  REPORT
  PHOTO_LINK
  VIDEO_LINK
  CONFIRMATION
}

model Deed {
  id          String    @id @default(cuid())
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  direction   String
  proofType   ProofType @default(PHOTO_LINK)
  canRepeat   Boolean   @default(false)
  bookCode    String?
  difficulty  Int       @default(1)
  createdAt   DateTime  @default(now())
  edgeTasks   TeamEdgeTask[]

  @@index([gameId])
}

enum EdgeTaskStatus {
  OPEN
  TAKEN
  SUBMITTED
  APPROVED
  REJECTED
}

/** Узел глазами команды: открыт (виден тип, название города). */
model TeamNodeState {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey    String
  revealedAt DateTime @default(now())

  @@unique([teamId, nodeKey])
}

/** Ребро глазами команды: назначенное дело и ход его выполнения. */
model TeamEdgeTask {
  id            String         @id @default(cuid())
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gameId        String
  fromKey       String
  toKey         String
  deedId        String
  deed          Deed           @relation(fields: [deedId], references: [id])
  status        EdgeTaskStatus @default(OPEN)
  takenById     String?
  links         String[]       @default([])
  note          String         @default("")
  submittedAt   DateTime?
  decidedAt     DateTime?
  decidedById   String?
  adminComment  String         @default("")
  createdAt     DateTime       @default(now())

  @@unique([teamId, fromKey, toKey])
  @@index([gameId, status])
}

/**
 * Прогресс команды в городе: собрана ли структура книги (районы), какие задания районов решены,
 * взят ли город. Задания и ответы — неизменяемый контент платформы (content/cities/*.json).
 */
model TeamCityState {
  id             String    @id @default(cuid())
  gameId         String
  teamId         String
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey        String
  orderSolved    Boolean   @default(false)
  orderAttempts  Int       @default(0)
  doneTasks      Int[]     @default([])
  answerAttempts Int       @default(0)
  lastWrongAt    DateTime?
  capturedAt     DateTime?
  isCapital      Boolean   @default(false)
  /** Захваченная чужая столица: вторая столица, переносить нельзя. */
  secondCapital  Boolean   @default(false)
  /** Штраф к минимальной ставке за сгоревшие атаки этой команды на этот город (+5 за каждую). */
  attackPenalty  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([teamId, nodeKey])
  @@index([gameId, nodeKey])
}

enum BattleStatus {
  QUEUED
  ATTACK
  DEFENSE
  WON
  REPELLED
  EXPIRED
  CANCELLED
}

enum BattleSide {
  ATTACK
  DEFENSE
}

enum EntryStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/**
 * Битва за город (2.8). Атакующие получают случайный отрывок из N стихов и прикрепляют ссылки на видео;
 * T = от начала атаки до последней ссылки; после одобрения админом у защитников ровно T на ответ M ≥ N.
 */
model Battle {
  id                String       @id @default(cuid())
  gameId            String
  nodeKey           String
  bookCode          String
  attackerId        String
  attacker          Team         @relation("attacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defenderId        String
  defender          Team         @relation("defender", fields: [defenderId], references: [id], onDelete: Cascade)
  status            BattleStatus @default(QUEUED)
  sumMode           Boolean      @default(false)
  bid               Int
  defenseBid        Int?
  passageStart      Int?
  passageEnd        Int?
  /** Отрывок обороны, выбранный капитаном защитников (последовательный, из всей книги). */
  defenseStart      Int?
  defenseEnd        Int?
  declaredAt        DateTime     @default(now())
  startedAt         DateTime?
  attackDeadline    DateTime?
  attackDoneAt      DateTime?
  attackApprovedAt  DateTime?
  defenseDeadline   DateTime?
  defenseDoneAt     DateTime?
  resolvedAt        DateTime?
  entries           BattleEntry[]

  @@index([gameId, nodeKey, status])
  @@index([gameId, status])
}

model BattleEntry {
  id           String      @id @default(cuid())
  battleId     String
  battle       Battle      @relation(fields: [battleId], references: [id], onDelete: Cascade)
  side         BattleSide
  teamId       String
  userId       String
  startIdx     Int
  endIdx       Int
  links        String[]    @default([])
  note         String      @default("")
  status       EntryStatus @default(SUBMITTED)
  adminComment String      @default("")
  createdAt    DateTime    @default(now())
  decidedAt    DateTime?

  @@index([battleId, side])
}
