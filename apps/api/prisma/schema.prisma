generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum GameStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum NodeKind {
  EMPTY
  CITY
  START
}

model User {
  id           String       @id @default(cuid())
  nickname     String       @unique
  passwordHash String
  email        String?      @unique
  displayName  String?
  locale       String       @default("ru")
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  /** Последняя активность (обновляется не чаще раза в 10 минут) — для DAU/WAU/MAU и удержания. */
  lastSeenAt   DateTime?
  sessions     Session[]
  gameAdmins   GameAdmin[]
  createdGames Game[]       @relation("GameCreator")
  memberships  Membership[]
  resets       PasswordReset[]
  pushSubscriptions PushSubscription[]
}

/** Настройки платформы, которые сервер создаёт сам (например ключи VAPID для push-уведомлений). */
model AppSetting {
  key   String @id
  value String
}

/** Push-подписка браузера (одно устройство / один браузер). Endpoint и ключи выдаёт браузер; адресов и имён тут нет. */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ResetKind {
  EMAIL
  ADMIN
}

/** Одноразовая ссылка сброса пароля. id — SHA-256 от токена из ссылки; сам токен нигде не хранится. */
model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ResetKind @default(EMAIL)
  issuedBy  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  games     Game[]
}

model Game {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  status      GameStatus   @default(DRAFT)
  teamCount   Int
  settings    Json         @default("{}")
  mapSeed     Int?
  createdById String
  createdBy   User         @relation("GameCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  admins      GameAdmin[]
  hexes       MapHex[]
  nodes       MapNode[]
  edges       MapEdge[]
  teams       Team[]
  invites     Invite[]
  deeds       Deed[]
  startedAt   DateTime?
  finishedAt   DateTime?
  winnerTeamId String?
  /** Почему завершена: last_team (осталась одна команда), time_limit (срок), manual (админ). */
  finishReason String?
  recipients  Recipient[]
}

model GameAdmin {
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gameId, userId])
}

/** Гекс — местность (декорация и туман). */
model MapHex {
  id       String @id @default(cuid())
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  q        Int
  r        Int
  terrain  String
  rotation Int    @default(0)

  @@unique([gameId, q, r])
}

/** Узел — перекрёсток (вершина гекса): развилка, город или старт. */
model MapNode {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  key       String
  corner    String   @default("N")
  q         Int
  r         Int
  kind      NodeKind
  bookCode  String?
  cityType  String?
  teamIndex Int?
  /** Ключ конверта города (генерируется при старте игры, виден только админу). */
  cityKey   String?
  /** Шифр города: случайные буквы и цифры, по знаку на район; команда собирает его заданиями. Свой в каждой игре. */
  cityCode  String?
  /** Адресат конверта этого города (семья, вдова, старица), назначается по кругу из списка игры. */
  recipientId String?
  recipient   Recipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  /** Уровень защиты города: сколько стихов надо, чтобы его взять (следующая атака ≥ level + 1). */
  defenseLevel  Int     @default(0)
  /** Книга исчерпана: ставки считаются суммой стихов по участникам. */
  sumMode       Boolean @default(false)
  /** Отражена атака в суммарном режиме: город закреплён навсегда. */
  lockedForever Boolean @default(false)
  /** Руины: город выбывшей команды. Берётся выполнением заданий, без ключа и без битвы. */
  ruined        Boolean @default(false)

  @@unique([gameId, key])
}

model MapEdge {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  aKey   String
  bKey   String

  @@unique([gameId, aKey, bKey])
}

enum TeamRole {
  CAPTAIN
  MEMBER
}

enum GameRole {
  NONE
  SCOUT
  PROPHET
  AMBASSADOR
  CHRONICLER
}

model Team {
  id           String       @id @default(cuid())
  gameId       String
  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  index        Int
  name         String
  color        String
  startNodeKey String?
  status       String       @default("active")
  /** Единственный перенос столицы за игру (2.9). */
  capitalMovedAt DateTime?
  /** Разведчик: последний «взгляд» за ребро (раз в неделю). */
  lastPeekAt     DateTime?
  /** Пророк: последняя подсказка к заданию города (раз в неделю). */
  lastHintAt     DateTime?
  peeks          TeamPeek[]
  passageOut     PassageRequest[] @relation("requester")
  passageIn      PassageRequest[] @relation("owner")
  createdAt    DateTime     @default(now())
  members      Membership[]
  invites      Invite[]
  nodeStates   TeamNodeState[]
  edgeTasks    TeamEdgeTask[]
  taskLocks    TeamTaskLock[]
  cityStates   TeamCityState[]
  attacks      Battle[]  @relation("attacker")
  defenses     Battle[]  @relation("defender")

  @@unique([gameId, index])
  @@unique([gameId, name])
}

model Membership {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(MEMBER)
  gameRole GameRole @default(NONE)
  joinedAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

model Invite {
  id        String   @id
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole @default(MEMBER)
  usesLeft  Int      @default(20)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum ProofType {
  REPORT
  PHOTO_LINK
  VIDEO_LINK
  CONFIRMATION
}

model Deed {
  id          String    @id @default(cuid())
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  direction   String
  proofType   ProofType @default(PHOTO_LINK)
  canRepeat   Boolean   @default(false)
  bookCode    String?
  difficulty  Int       @default(1)
  createdAt   DateTime  @default(now())
  edgeTasks   TeamEdgeTask[]

  @@index([gameId])
}

enum EdgeTaskStatus {
  OPEN
  TAKEN
  SUBMITTED
  APPROVED
  REJECTED
}

/** Узел глазами команды: открыт (виден тип, название города). */
model TeamNodeState {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey    String
  revealedAt DateTime @default(now())

  @@unique([teamId, nodeKey])
}

/** Ребро глазами команды: назначенное дело и ход его выполнения. */
model TeamEdgeTask {
  id            String         @id @default(cuid())
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gameId        String
  fromKey       String
  toKey         String
  deedId        String
  deed          Deed           @relation(fields: [deedId], references: [id])
  status        EdgeTaskStatus @default(OPEN)
  takenById     String?
  links         String[]       @default([])
  note          String         @default("")
  submittedAt   DateTime?
  decidedAt     DateTime?
  /** Дело заменено пожертвованием (сумма в валюте игры, чек — ссылкой). */
  donation       Boolean   @default(false)
  donationAmount Int?
  decidedById   String?
  adminComment  String         @default("")
  createdAt     DateTime       @default(now())

  @@unique([teamId, fromKey, toKey])
  @@index([gameId, status])
}

/**
 * Прогресс команды в городе: собрана ли структура книги (районы), какие задания районов решены,
 * взят ли город. Задания и ответы — неизменяемый контент платформы (content/cities/*.json).
 */
/**
 * Задание с выбором ответа: две попытки, после второй неверной — блокировка на сутки.
 * Команда может оспорить блокировку сообщением админу; админ снимает блокировку или оставляет и отвечает.
 */
model TeamTaskLock {
  id          String    @id @default(cuid())
  gameId      String
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey     String
  taskIndex   Int
  /** Неверных попыток в текущем цикле (сбрасывается при блокировке и при снятии блокировки). */
  wrong       Int       @default(0)
  lockedUntil DateTime?
  dispute     String?
  disputedAt  DateTime?
  resolvedAt  DateTime?
  resolution  String?
  unlocked    Boolean   @default(false)
  /** Накопленное время чтения задания командой (мс): растёт только пока задание открыто на экране. */
  readMs      Int       @default(0)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([teamId, nodeKey, taskIndex])
  @@index([gameId, disputedAt])
}

model TeamCityState {
  id             String    @id @default(cuid())
  gameId         String
  teamId         String
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey        String
  orderSolved    Boolean   @default(false)
  orderAttempts  Int       @default(0)
  doneTasks      Int[]     @default([])
  answerAttempts Int       @default(0)
  lastWrongAt    DateTime?
  capturedAt     DateTime?
  /** Когда команда впервые взяла этот город (не сбрасывается при потере — для итоговой статистики). */
  firstCapturedAt DateTime?
  isCapital      Boolean   @default(false)
  /** Захваченная чужая столица: вторая столица, переносить нельзя. */
  secondCapital  Boolean   @default(false)
  /** Штраф к минимальной ставке за сгоревшие атаки этой команды на этот город (+5 за каждую). */
  attackPenalty  Int       @default(0)
  /** Задания, к которым пророк открыл подсказку (текст стихов района). */
  hintTasks      Int[]     @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([teamId, nodeKey])
  @@index([gameId, nodeKey])
}

enum BattleStatus {
  QUEUED
  ATTACK
  DEFENSE
  WON
  REPELLED
  EXPIRED
  CANCELLED
}

enum BattleSide {
  ATTACK
  DEFENSE
}

enum EntryStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/**
 * Битва за город (2.8). Атакующие получают случайный отрывок из N стихов и прикрепляют ссылки на видео;
 * T = от начала атаки до последней ссылки; после одобрения админом у защитников ровно T на ответ M ≥ N.
 */
model Battle {
  id                String       @id @default(cuid())
  gameId            String
  nodeKey           String
  bookCode          String
  attackerId        String
  attacker          Team         @relation("attacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defenderId        String
  defender          Team         @relation("defender", fields: [defenderId], references: [id], onDelete: Cascade)
  status            BattleStatus @default(QUEUED)
  sumMode           Boolean      @default(false)
  bid               Int
  defenseBid        Int?
  passageStart      Int?
  passageEnd        Int?
  /** Отрывок обороны, выбранный капитаном защитников (последовательный, из всей книги). */
  defenseStart      Int?
  defenseEnd        Int?
  declaredAt        DateTime     @default(now())
  startedAt         DateTime?
  attackDeadline    DateTime?
  attackDoneAt      DateTime?
  attackApprovedAt  DateTime?
  defenseDeadline   DateTime?
  defenseDoneAt     DateTime?
  resolvedAt        DateTime?
  entries           BattleEntry[]

  @@index([gameId, nodeKey, status])
  @@index([gameId, status])
}

model BattleEntry {
  id           String      @id @default(cuid())
  battleId     String
  battle       Battle      @relation(fields: [battleId], references: [id], onDelete: Cascade)
  side         BattleSide
  teamId       String
  userId       String
  startIdx     Int
  endIdx       Int
  links        String[]    @default([])
  note         String      @default("")
  status       EntryStatus @default(SUBMITTED)
  adminComment String      @default("")
  createdAt    DateTime    @default(now())
  decidedAt    DateTime?

  @@index([battleId, side])
}

enum PassageStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
  REVOKED
}

/** Запрос прохода через чужой город (2.14 А): 3 дня на ответ, молчание = отказ; разрешение постоянное, но отзываемое. */
model PassageRequest {
  id          String        @id @default(cuid())
  gameId      String
  nodeKey     String
  requesterId String
  requester   Team          @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       Team          @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  message     String        @default("")
  answer      String        @default("")
  status      PassageStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  expiresAt   DateTime
  decidedAt   DateTime?

  @@index([gameId, nodeKey])
  @@index([requesterId])
  @@index([ownerId])
}

/** Разведчик заглянул за ребро: известно, город там или пустая развилка (без названия). */
model TeamPeek {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey   String
  createdAt DateTime @default(now())

  @@unique([teamId, nodeKey])
}

/**
 * Адресат конверта: кому команда несёт шифр. Только короткая подпись и тип — без адресов и телефонов.
 * Список живёт в базе игры и стирается при её завершении.
 */
model Recipient {
  id        String        @id @default(cuid())
  gameId    String
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  label     String
  kind      RecipientKind @default(FAMILY)
  createdAt DateTime      @default(now())
  nodes     MapNode[]

  @@index([gameId])
}

enum RecipientKind {
  FAMILY
  WIDOW
  ELDER
  OTHER
}
