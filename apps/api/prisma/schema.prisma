generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum GameStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum NodeKind {
  EMPTY
  CITY
  START
}

model User {
  id           String       @id @default(cuid())
  nickname     String       @unique
  passwordHash String
  email        String?      @unique
  /** Почта подтверждена ссылкой из письма. Учётки, созданные до ввода подтверждения, считаются подтверждёнными. */
  emailVerified Boolean     @default(false)
  /** Идентификатор Google (sub) для входа через Google. Имя и фото из Google не хранятся. */
  googleId     String?      @unique
  displayName  String?
  locale       String       @default("ru")
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  /** Защита от подбора пароля (решение владельца 22.09): неверных попыток подряд; после 10 — вход закрыт до lockedUntil (15 минут),
   *  владельцу уходит письмо один раз за блокировку. Успешный вход и смена пароля обнуляют. */
  failedLogins Int          @default(0)
  lockedUntil  DateTime?
  /** Последняя активность (обновляется не чаще раза в 10 минут) — для DAU/WAU/MAU и удержания. */
  lastSeenAt   DateTime?
  sessions     Session[]
  gameAdmins   GameAdmin[]
  createdGames Game[]       @relation("GameCreator")
  memberships  Membership[]
  resets       PasswordReset[]
  verifications EmailVerification[]
  pushSubscriptions PushSubscription[]
  supportRequests SupportRequest[]
}

/** Настройки платформы, которые сервер создаёт сам (например ключи VAPID для push-уведомлений). */
model AppSetting {
  key   String @id
  value String
}

/** Push-подписка браузера (одно устройство / один браузер). Endpoint и ключи выдаёт браузер; адресов и имён тут нет. */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ResetKind {
  EMAIL
  ADMIN
}

/** Одноразовая ссылка сброса пароля. id — SHA-256 от токена из ссылки; сам токен нигде не хранится. */
/** Одноразовая ссылка подтверждения почты: id — хеш токена, письмо уходит на email на момент выпуска. */
model EmailVerification {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ResetKind @default(EMAIL)
  issuedBy  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  games     Game[]
}

model Game {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  status      GameStatus   @default(DRAFT)
  teamCount   Int
  settings    Json         @default("{}")
  mapSeed     Int?
  createdById String
  createdBy   User         @relation("GameCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  admins      GameAdmin[]
  hexes       MapHex[]
  nodes       MapNode[]
  edges       MapEdge[]
  teams       Team[]
  invites     Invite[]
  deeds       Deed[]
  startedAt   DateTime?
  finishedAt   DateTime?
  winnerTeamId String?
  /** Почему завершена: last_team (осталась одна команда), time_limit (срок), manual (админ). */
  finishReason String?
  recipients  Recipient[]
  supportRequests SupportRequest[]
  journal     Journal[]
  peaces      Peace[]
}

model GameAdmin {
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gameId, userId])
}

/** Гекс — местность (декорация и туман). */
model MapHex {
  id       String @id @default(cuid())
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  q        Int
  r        Int
  terrain  String
  rotation Int    @default(0)
  /** Остров: OT — Ветхий Завет, NT — Новый Завет (карты до сентября 2026 — один остров OT). */
  island   String @default("OT")

  @@unique([gameId, q, r])
}

/** Узел — перекрёсток (вершина гекса): развилка, город или старт. */
model MapNode {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  key       String
  corner    String   @default("N")
  q         Int
  r         Int
  kind      NodeKind
  bookCode  String?
  cityType  String?
  teamIndex Int?
  island    String   @default("OT")
  /** Береговой узел: хотя бы один гекс вокруг — море. Береговой город — порт: из него команда может уплыть на другой остров. */
  coastal   Boolean  @default(false)
  /** Ключ конверта города (генерируется при старте игры, виден только админу). */
  cityKey   String?
  /** Шифр города: случайные буквы и цифры, по знаку на район; команда собирает его заданиями. Свой в каждой игре. */
  cityCode  String?
  /** Адресат конверта этого города (семья, вдова, старица), назначается по кругу из списка игры. */
  recipientId String?
  recipient   Recipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  /** Уровень защиты города: сколько стихов надо, чтобы его взять (следующая атака ≥ level + 1). */
  defenseLevel  Int     @default(0)
  /** Книга исчерпана: ставки считаются суммой стихов по участникам. */
  sumMode       Boolean @default(false)
  /** Закреплён до этой даты: хранители отбились с максимумом (каждый участник выучил всю книгу). Решение владельца 18.09: навечно — никогда. */
  lockedUntil   DateTime?
  /** Хранители достигли максимума: после закрепления город берётся только осадой делами. Сбрасывается со сменой владельца. */
  maxReachedAt  DateTime?
  /** Усталость города: когда уровень защиты в последний раз уменьшался за бездействие (28 дней без дел после города — минус 1 стих каждые 14 дней). */
  fatigueAt     DateTime?
  /** Руины: город выбывшей команды. Берётся выполнением заданий, без ключа и без битвы. */
  ruined        Boolean @default(false)
  /** Руины с сокровищем (решение владельца 18.09): какая команда первой изучила руины и получила находку — знак шифра соседнего города. */
  treasureTeamId String?

  @@unique([gameId, key])
}

model MapEdge {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  aKey   String
  bKey   String

  @@unique([gameId, aKey, bKey])
}

enum TeamRole {
  CAPTAIN
  /** Заместитель капитана: назначает капитан; все права капитана, кроме назначения ролей. */
  DEPUTY
  MEMBER
}

enum GameRole {
  NONE
  SCOUT
  PROPHET
  AMBASSADOR
  CHRONICLER
  /** Кормчий: морские переходы и выбор места высадки. */
  HELMSMAN
}

model Team {
  id           String       @id @default(cuid())
  gameId       String
  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  index        Int
  name         String
  color        String
  startNodeKey String?
  status       String       @default("active")
  /** Единственный перенос столицы за игру (2.9). */
  capitalMovedAt DateTime?
  /** Разведчик: последний «взгляд» за ребро (раз в неделю). */
  lastPeekAt     DateTime?
  /** Пророк: последняя подсказка к заданию города (раз в неделю). */
  lastHintAt     DateTime?
  /** Смена игровых ролей — не чаще раза в неделю и только с одобрения администратора (решение владельца 18.09). */
  lastRoleChangeAt DateTime?
  penalties      TeamPenalty[]
  peeks          TeamPeek[]
  passageOut     PassageRequest[] @relation("requester")
  passageIn      PassageRequest[] @relation("owner")
  createdAt    DateTime     @default(now())
  members      Membership[]
  invites      Invite[]
  nodeStates   TeamNodeState[]
  edgeTasks    TeamEdgeTask[]
  taskLocks    TeamTaskLock[]
  cityStates   TeamCityState[]
  attacks      Battle[]  @relation("attacker")
  defenses     Battle[]  @relation("defender")

  @@unique([gameId, index])
  @@unique([gameId, name])
  supportRequests SupportRequest[]
  peaceOut       Peace[] @relation("peaceFrom")
  peaceIn        Peace[] @relation("peaceTo")
}

model Membership {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(MEMBER)
  gameRole GameRole @default(NONE)
  /** Роль, запрошенная капитаном и ждущая одобрения администратора. */
  pendingRole GameRole?
  joinedAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

model Invite {
  id        String   @id
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole @default(MEMBER)
  usesLeft  Int      @default(20)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum ProofType {
  REPORT
  PHOTO_LINK
  VIDEO_LINK
  CONFIRMATION
}

model Deed {
  id          String    @id @default(cuid())
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  direction   String
  proofType   ProofType @default(PHOTO_LINK)
  canRepeat   Boolean   @default(false)
  /** Книги, к которым дело подходит по теме (коды); пусто — любая. Текст может содержать [Книга] — подставляется книга города. */
  bookCodes   String[]  @default([])
  difficulty  Int       @default(1)
  /** Частота появления: 1 — редко, 2 — обычно, 3 — часто (веса 1 : 3 : 6 при выборе дела). */
  frequency   Int       @default(2)
  /** Хеш версии стандартного набора, из которой взято дело; пока администратор дело не правил, совпадает с хешем содержимого — такие дела сервер обновляет сам при выходе новой версии набора. */
  sourceHash  String?
  /** Тайное дело: ссылки и описание сдачи видит только проверяющий администратор, не команда (сюрприз без раскрытия адресата). */
  secret      Boolean   @default(false)
  /** Можно сделать издалека (уехал, болеет): среди свободных сторон команды всегда есть хотя бы одно такое дело. */
  remote      Boolean   @default(false)
  /** Баллы за это дело при осаде делами (пусто — значение по умолчанию из правил игры). */
  siegePoints Int?
  createdAt   DateTime  @default(now())
  edgeTasks   TeamEdgeTask[]

  @@index([gameId])
}

enum EdgeTaskStatus {
  OPEN
  TAKEN
  SUBMITTED
  APPROVED
  REJECTED
}

/** Узел глазами команды: открыт (виден тип, название города). */
model TeamNodeState {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey    String
  revealedAt DateTime @default(now())

  @@unique([teamId, nodeKey])
}

/** Ребро глазами команды: назначенное дело и ход его выполнения. */
model TeamEdgeTask {
  id            String         @id @default(cuid())
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gameId        String
  fromKey       String
  toKey         String
  deedId        String
  deed          Deed           @relation(fields: [deedId], references: [id])
  status        EdgeTaskStatus @default(OPEN)
  takenById     String?
  /** Когда дело взято: не сданное за 14 дней возвращается в общий список само. */
  takenAt       DateTime?
  links         String[]       @default([])
  note          String         @default("")
  submittedAt   DateTime?
  decidedAt     DateTime?
  /** Дело заменено пожертвованием (сумма в валюте игры, чек — ссылкой). */
  donation       Boolean   @default(false)
  donationAmount Int?
  /** Морская сторона: дело из взятого порта; после одобрения капитан выбирает узел высадки на другом острове (toKey до высадки — «sea:<порт>»). */
  sea           Boolean        @default(false)
  /** Кто участвовал в деле (группой): id пользователей; каждому засчитывается в личное служение, сторона одна. */
  participants  String[]       @default([])
  decidedById   String?
  adminComment  String         @default("")
  createdAt     DateTime       @default(now())

  @@unique([teamId, fromKey, toKey])
  @@index([gameId, status])
}

/**
 * Прогресс команды в городе: собрана ли структура книги (районы), какие задания районов решены,
 * взят ли город. Задания и ответы — неизменяемый контент платформы (content/cities/*.json).
 */
/**
 * Растущая пауза после неверного ответа на задание города (решение владельца 3.19): считается на задание,
 * каждая ошибка подряд удлиняет паузу по ступеням правил игры (20 с, 1 мин, 5 мин, 15 мин, час…), верный ответ сбрасывает счёт.
 * Попыток не ограничено, блокировки на сутки и «снятия блокировки» поддержкой нет.
 */
model TeamTaskLock {
  id          String    @id @default(cuid())
  gameId      String
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey     String
  taskIndex   Int
  /** Неверных ответов подряд (сбрасывается верным ответом). */
  wrong       Int       @default(0)
  /** До какого момента ответ не принимается (текущая пауза). */
  lockedUntil DateTime?
  /** Не используется: «снятие блокировки» поддержкой убрано (решение владельца 3.19). Колонка оставлена, чтобы не делать миграцию. */
  unlocked    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([teamId, nodeKey, taskIndex])
}

model TeamCityState {
  id             String    @id @default(cuid())
  gameId         String
  teamId         String
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey        String
  orderSolved    Boolean   @default(false)
  orderAttempts  Int       @default(0)
  doneTasks      Int[]     @default([])
  answerAttempts Int       @default(0)
  lastWrongAt    DateTime?
  capturedAt     DateTime?
  /** Когда команда впервые взяла этот город (не сбрасывается при потере — для итоговой статистики). */
  firstCapturedAt DateTime?
  isCapital      Boolean   @default(false)
  /** Захваченная чужая столица: вторая столица, переносить нельзя. */
  secondCapital  Boolean   @default(false)
  /** Штраф к минимальной ставке за сгоревшие атаки этой команды на этот город (+5 за каждую). */
  attackPenalty  Int       @default(0)
  /** Задания, к которым пророк открыл подсказку (текст стихов района). */
  hintTasks      Int[]     @default([])
  /** Неверные ключи конверта подряд и пауза до следующей попытки (растущая пауза, решение владельца 18.09). */
  keyWrong       Int       @default(0)
  keyLockedUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([teamId, nodeKey])
  @@index([gameId, nodeKey])
}

enum BattleStatus {
  QUEUED
  ATTACK
  DEFENSE
  WON
  REPELLED
  EXPIRED
  CANCELLED
}

enum BattleSide {
  ATTACK
  DEFENSE
}

enum EntryStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/**
 * Битва за город (2.8). Атакующие получают случайный отрывок из N стихов и прикрепляют ссылки на видео;
 * T = от начала атаки до последней ссылки; после одобрения админом у защитников ровно T на ответ M ≥ N.
 */
model Battle {
  id                String       @id @default(cuid())
  gameId            String
  nodeKey           String
  bookCode          String
  attackerId        String
  attacker          Team         @relation("attacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defenderId        String
  defender          Team         @relation("defender", fields: [defenderId], references: [id], onDelete: Cascade)
  status            BattleStatus @default(QUEUED)
  sumMode           Boolean      @default(false)
  bid               Int
  defenseBid        Int?
  passageStart      Int?
  passageEnd        Int?
  /** Отрывок обороны, выбранный капитаном защитников (последовательный, из всей книги). */
  defenseStart      Int?
  defenseEnd        Int?
  declaredAt        DateTime     @default(now())
  startedAt         DateTime?
  attackDeadline    DateTime?
  attackDoneAt      DateTime?
  attackApprovedAt  DateTime?
  defenseDeadline   DateTime?
  defenseDoneAt     DateTime?
  resolvedAt        DateTime?
  /** Сколько времени вызов стоял на проверке у администратора (после возврата записи): в T не входит — стоп-часы. */
  attackPausedMs    Int          @default(0)
  /** Вызов объявлен после того, как предыдущий вызов этой команды этому городу сгорел: в очереди — после всех, кто встал раньше. */
  afterBurn         Boolean      @default(false)
  entries           BattleEntry[]

  @@index([gameId, nodeKey, status])
  @@index([gameId, status])
}

model BattleEntry {
  id           String      @id @default(cuid())
  battleId     String
  battle       Battle      @relation(fields: [battleId], references: [id], onDelete: Cascade)
  side         BattleSide
  teamId       String
  userId       String
  startIdx     Int
  endIdx       Int
  links        String[]    @default([])
  note         String      @default("")
  status       EntryStatus @default(SUBMITTED)
  adminComment String      @default("")
  /** Зачтено из прошлого испытания: выученные стихи хранителей засчитываются в новых вызовах автоматически. */
  carried      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  decidedAt    DateTime?

  @@index([battleId, side])
}

enum SiegeStatus {
  ACTIVE
  WON
  REPELLED
  CANCELLED
}

/**
 * Осада делами (решение владельца 18.09): город, где хранители отбились с максимумом, после закрепления берётся не стихами,
 * а делами — 14 дней обе команды делают дела, за каждое одобренное — баллы; у кого больше, тот владеет; при равенстве город остаётся.
 */
model Siege {
  id         String      @id @default(cuid())
  gameId     String
  nodeKey    String
  attackerId String
  defenderId String
  status     SiegeStatus @default(ACTIVE)
  startedAt  DateTime    @default(now())
  endsAt     DateTime
  attackerPoints Int     @default(0)
  defenderPoints Int     @default(0)
  resolvedAt DateTime?

  @@index([gameId, nodeKey, status])
}

/** Штраф администратора (телефон на собрании): аннулирован концевой участок пути команды. */
model TeamPenalty {
  id        String   @id @default(cuid())
  gameId    String
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fromKey   String
  toKey     String
  byId      String
  createdAt DateTime @default(now())

  @@index([gameId, teamId])
}

enum PassageStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
  REVOKED
}

/** Запрос прохода через чужой город (2.14 А): срок на ответ из правил, молчание = отказ; разрешение постоянное и безотзывное; REVOKED — сброс при смене владельца города (S-14). */
model PassageRequest {
  id          String        @id @default(cuid())
  gameId      String
  nodeKey     String
  requesterId String
  requester   Team          @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       Team          @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  message     String        @default("")
  answer      String        @default("")
  status      PassageStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  expiresAt   DateTime
  decidedAt   DateTime?

  @@index([gameId, nodeKey])
  @@index([requesterId])
  @@index([ownerId])
}

/** Разведчик заглянул за ребро: известно, город там или пустая развилка (без названия). */
model TeamPeek {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nodeKey   String
  createdAt DateTime @default(now())

  @@unique([teamId, nodeKey])
}

/**
 * Адресат конверта: кому команда несёт шифр. Только короткая подпись и тип — без адресов и телефонов.
 * Список живёт в базе игры и стирается при её завершении.
 */
model Recipient {
  id        String        @id @default(cuid())
  gameId    String
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  label     String
  kind      RecipientKind @default(FAMILY)
  createdAt DateTime      @default(now())
  nodes     MapNode[]

  @@index([gameId])
}

enum RecipientKind {
  FAMILY
  WIDOW
  ELDER
  OTHER
}

/**
 * Замер интерфейса с устройства пользователя: скорость открытия страницы и плавность карты.
 * Только обобщённые числа и класс устройства — без пользователя, адреса и точной модели.
 */
model UiMetric {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  page      String   // map | admin-map | other
  device    String   // phone | desktop
  browser   String   // chrome | safari | firefox | other
  os        String   // android | ios | windows | mac | linux | other
  dpr       Float
  viewW     Int
  viewH     Int
  ttfb      Int?     // мс до первого байта
  fcp       Int?     // мс до первой отрисовки
  lcp       Int?     // мс до самой крупной отрисовки
  load      Int?     // мс до события load
  fps       Float?   // средние кадры в секунду за замер на карте
  jank      Float?   // доля кадров длиннее 50 мс, 0..1
  longTasks Int?     // длинных задач (>50 мс) за время замера
  memoryMb  Int?     // память устройства по navigator.deviceMemory, ГБ*1024, если известно

  @@index([createdAt])
}

/**
 * Обращение в поддержку: игрок описывает проблему, всё остальное (игра, команда, город, задание, состояние
 * блокировки) сервер подставляет сам. Уходит письмом на адрес поддержки и лежит в дашборде суперадмина.
 */
model SupportRequest {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  gameId     String
  game       Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teamId     String?
  team       Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeKey    String?
  bookCode   String?
  taskIndex  Int?
  message    String
  /** Снимок состояния на момент обращения: текст задания, решённые задания, текущая пауза. Без ответов. */
  context    Json
  status     SupportStatus @default(OPEN)
  reply      String?
  resolvedAt DateTime?
  /** Не используется: «снятие блокировки» по обращению убрано (решение владельца 3.19). */
  unlocked   Boolean       @default(false)

  @@index([status, createdAt])
  @@index([teamId, nodeKey])
}

enum SupportStatus {
  OPEN
  CLOSED
}

/**
 * Журнал событий игры (решения владельца 18.09, глава 4): основа ленты команды «Что случилось», новостей для всех
 * команд (испытания без ставок), воскресной летописи, «Моего служения» участника и «Книги сезона».
 * kind — вид события, vars — подстановки для текста (шаблоны в services/journal.ts), text — готовый текст (летопись).
 */
model Journal {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /** Команда, к которой относится запись (лента команды); null — общая запись. */
  teamId    String?
  /** Участник, чьё это действие («Моё служение», доска активности). */
  userId    String?
  kind      String
  /** Новость для всех команд. */
  everyone  Boolean  @default(false)
  vars      Json     @default("{}")
  text      String   @default("")
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
  @@index([teamId, createdAt])
  @@index([userId])
}

enum PeaceStatus {
  PROPOSED
  ACTIVE
  DECLINED
  ENDED
}

/** Мир между командами (решение владельца 18.09, B-12): пока действует, команды не бросают вызов городам друг друга; расторгается сразу, с новостью для всех. */
model Peace {
  id         String      @id @default(cuid())
  gameId     String
  game       Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  fromId     String
  from       Team        @relation("peaceFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String
  to         Team        @relation("peaceTo", fields: [toId], references: [id], onDelete: Cascade)
  status     PeaceStatus @default(PROPOSED)
  createdAt  DateTime    @default(now())
  decidedAt  DateTime?
  endedAt    DateTime?
  /** Кто расторг (команда). */
  endedById  String?

  @@index([gameId, status])
}
