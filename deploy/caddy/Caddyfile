{
	# Модуль rate_limit (сборка в deploy/caddy/Dockerfile) стоит перед проксированием.
	order rate_limit before reverse_proxy
}

{$DOMAIN} {
	# Первым — zstd: при равных предпочтениях браузера берётся первый способ из списка, а zstd сжимает плотнее и быстрее gzip.
	# Файлы программы приходят от приложения уже сжатыми (brotli) и повторно не сжимаются.
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Ограничение запросов. Пороги — решение владельца 22.09 и не менялись: вход и регистрация — 30 в минуту, остальное —
	# 300 за 10 секунд. Сверх лимита — 429. С 16.11 (решение владельца: «только /api и по игроку») считается иначе:
	# - только запросы игры (/api); картинки, шрифты и файлы программы не считаются — раньше трое, открывшие игру разом
	#   с одного Wi-Fi, упирались в лимит одними картинками;
	# - у вошедшего игрока счёт свой (по номеру сессии из cookie), а не общий на адрес сети: зал на одном Wi-Fi и абоненты
	#   одного оператора для прокси — один адрес; у гостя — по адресу, как раньше;
	# - строгая зона — сам вход, регистрация, сброс пароля и смена настроек аккаунта; чтение «кто я», «аккаунты на
	#   устройстве» и «способы входа» в неё не входит: его шлёт каждое открытие приложения, и 15 открытий в минуту
	#   с одного адреса её исчерпывали. Исключено именно чтение (GET): изменение аккаунта (PATCH /api/auth/me — смена
	#   почты шлёт письмо) остаётся в строгой зоне.
	# Отказы видны в журнале прокси: docker logs lotw-caddy 2>&1 | grep "rate limit".
	#
	# Первым и отдельно — потолок на адрес сети (1000 за 10 секунд; число утвердил владелец 16.11: «годится»). Cookie
	# присылает сам клиент: без потолка счёт «по игроку» обходился бы выдуманными номерами сессий, а каждый новый
	# номер — это ещё и память прокси. Потолок стоит отдельным обработчиком раньше остальных зон: запросы сверх него
	# отсекаются до того, как прокси заведёт счётчик на новый номер сессии (внутри одного обработчика порядок зон
	# выбирает сам модуль).
	rate_limit {
		zone address {
			match {
				path /api/*
			}
			key {remote_host}
			events 1000
			window 10s
		}
		sweep_interval 10s
	}
	# Счёт «по игроку» — только для cookie сессии правильного вида (43 знака номера, точка, подпись): ключ счётчика —
	# сам номер, фиксированной длины. Cookie любого другого вида считается по адресу, как у гостя.
	rate_limit {
		zone auth {
			match {
				path /api/auth/*
				not {
					method GET HEAD
					path /api/auth/me /api/auth/accounts /api/auth/providers
				}
			}
			key {remote_host}
			events 30
			window 1m
		}
		zone player {
			match {
				path /api/*
				header_regexp sess Cookie `(?:^|;\s*)lotw_session=([A-Za-z0-9_-]{43})\.`
			}
			key {http.regexp.sess.1}
			events 300
			window 10s
		}
		zone guest {
			match {
				path /api/*
				not header_regexp Cookie `(?:^|;\s*)lotw_session=([A-Za-z0-9_-]{43})\.`
			}
			key {remote_host}
			events 300
			window 10s
		}
		sweep_interval 10s
	}
	reverse_proxy lotw-app:3000 {
		flush_interval -1
		# Пока приложение перезапускается при выкладке, запрос ждёт до 20 секунд, а не получает ошибку 502.
		lb_try_duration 20s
		lb_try_interval 250ms
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Тестовый стенд (ветка staging, deploy/docker-compose.test.yml): контейнер lotw-app-test в общей сети.
# Поисковикам не индексировать. Если стенд не запущен — 502 только на этом адресе, прод не задет.
test.{$DOMAIN} {
	# Первым — zstd: при равных предпочтениях браузера берётся первый способ из списка, а zstd сжимает плотнее и быстрее gzip.
	# Файлы программы приходят от приложения уже сжатыми (brotli) и повторно не сжимаются.
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
	reverse_proxy lotw-app-test:3000 {
		flush_interval -1
		lb_try_duration 20s
		lb_try_interval 250ms
	}
}
