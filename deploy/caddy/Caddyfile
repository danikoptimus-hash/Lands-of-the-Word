{$DOMAIN} {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	reverse_proxy app:3000 {
		flush_interval -1
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
