{
	# Модуль rate_limit (сборка в deploy/caddy/Dockerfile) стоит перед проксированием.
	order rate_limit before reverse_proxy
}

{$DOMAIN} {
	# Первым — zstd: при равных предпочтениях браузера берётся первый способ из списка, а zstd сжимает плотнее и быстрее gzip.
	# Файлы программы приходят от приложения уже сжатыми (brotli) и повторно не сжимаются.
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Ограничение запросов. Пороги — решение владельца 22.09 и не менялись: вход и регистрация — 30 в минуту, остальное —
	# 300 за 10 секунд. Сверх лимита — 429. С 16.11 (решение владельца: «только /api и по игроку») считается иначе:
	# - только запросы игры (/api); картинки, шрифты и файлы программы не считаются — раньше трое, открывшие игру разом
	#   с одного Wi-Fi, упирались в лимит одними картинками;
	# - у вошедшего игрока счёт свой (по cookie сессии), а не общий на адрес сети: зал на одном Wi-Fi и абоненты одного
	#   оператора для прокси — один адрес; у гостя — по адресу, как раньше;
	# - строгая зона — сам вход, регистрация и сброс пароля; запросы «кто я», «аккаунты на устройстве» и «способы входа»
	#   в неё не входят: их шлёт каждое открытие приложения, и 15 открытий в минуту с одного адреса её исчерпывали.
	# Потолок на адрес (3000 за 10 секунд, вдесятеро выше лимита игрока) — чтобы подставной cookie не давал обойти
	# ограничение с одного адреса. Отказы видны в журнале прокси: docker logs lotw-caddy 2>&1 | grep "rate limit".
	rate_limit {
		zone auth {
			match {
				path /api/auth/*
				not path /api/auth/me /api/auth/accounts /api/auth/providers
			}
			key {remote_host}
			events 30
			window 1m
		}
		zone player {
			match {
				path /api/*
				header Cookie *lotw_session=*
			}
			key {http.request.cookie.lotw_session}
			events 300
			window 10s
		}
		zone guest {
			match {
				path /api/*
				not header Cookie *lotw_session=*
			}
			key {remote_host}
			events 300
			window 10s
		}
		zone address {
			match {
				path /api/*
			}
			key {remote_host}
			events 3000
			window 10s
		}
	}
	reverse_proxy lotw-app:3000 {
		flush_interval -1
		# Пока приложение перезапускается при выкладке, запрос ждёт до 20 секунд, а не получает ошибку 502.
		lb_try_duration 20s
		lb_try_interval 250ms
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Тестовый стенд (ветка staging, deploy/docker-compose.test.yml): контейнер lotw-app-test в общей сети.
# Поисковикам не индексировать. Если стенд не запущен — 502 только на этом адресе, прод не задет.
test.{$DOMAIN} {
	# Первым — zstd: при равных предпочтениях браузера берётся первый способ из списка, а zstd сжимает плотнее и быстрее gzip.
	# Файлы программы приходят от приложения уже сжатыми (brotli) и повторно не сжимаются.
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
	reverse_proxy lotw-app-test:3000 {
		flush_interval -1
		lb_try_duration 20s
		lb_try_interval 250ms
	}
}
